{
  "name": "piswitch",
  "version": "0.1.0",
  "description": "Universal video mixer service and CLI for Raspberry Pi: ATEM hardware switchers, software mixing, and phone camera feeds",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "tsx --test tests/**/*.test.ts",
    "cli": "tsx src/cli.ts"
  },
  "bin": {
    "piswitch": "bin/piswitch.mjs"
  },
  "dependencies": {
    "atem-connection": "^2.5.0",
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3"
  },
  "files": [
    "dist",
    "bin",
    "openapi"
  ],
  "pi": {
    "service": "piswitch",
    "displayName": "PiSwitch",
    "layer": "Layer 1: Southbound hardware",
    "port": 3103,
    "ports": {},
    "healthEndpoint": "/health",
    "envPortVar": "PISWITCH_PORT"
  }
}
