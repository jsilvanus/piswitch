# piswitch HTTP port and host
PISWITCH_PORT=3106
PISWITCH_HOST=0.0.0.0

# Backend switcher mode: "atem" (hardware switcher), "pi" (software mixer on Pi), or "mock" (simulation)
PISWITCH_BACKEND=atem

# ATEM switcher connection (when PISWITCH_BACKEND=atem)
PISWITCH_ATEM_HOST=192.168.1.20
PISWITCH_ATEM_PORT=9910

# API authentication key (protects non-GET endpoints under /api/v1/)
# PISWITCH_API_KEY=secret_key_here
PISWITCH_AUTH_ALLOWED_HOSTS=127.0.0.1,::1,localhost
